{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!admin\\.html|admin-manifest\\.webmanifest|sw\\.js|workbox-.*|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
