rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOrderStatus(status) {
      return status in ['pending', 'accepted', 'preparing', 'delivering', 'completed', 'cancelled'];
    }

    function isValidVault(data) {
      return data.keys().hasAll([
          'publicKeyJwk',
          'encryptedVaultBlob',
          'salt',
          'iv',
          'adminSecretHash',
          'lastActionId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'publicKeyJwk',
          'encryptedVaultBlob',
          'salt',
          'iv',
          'adminSecretHash',
          'lastActionId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.publicKeyJwk is string &&
        data.publicKeyJwk.size() >= 50 &&
        data.publicKeyJwk.size() <= 2000 &&
        data.encryptedVaultBlob is string &&
        data.encryptedVaultBlob.size() >= 40 &&
        data.encryptedVaultBlob.size() <= 12000 &&
        data.salt is string &&
        data.salt.size() >= 12 &&
        data.salt.size() <= 128 &&
        data.iv is string &&
        data.iv.size() >= 12 &&
        data.iv.size() <= 64 &&
        data.adminSecretHash is string &&
        data.adminSecretHash.size() >= 32 &&
        data.adminSecretHash.size() <= 128 &&
        data.lastActionId is string &&
        data.lastActionId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminProof(data) {
      return data.keys().hasAll([
          'targetType',
          'targetId',
          'targetStatus',
          'adminSecret',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'targetType',
          'targetId',
          'targetStatus',
          'adminSecret',
          'createdAt'
        ]) &&
        data.targetType in ['order', 'complaint', 'vault'] &&
        data.targetId is string &&
        data.targetId.size() >= 3 &&
        data.targetId.size() <= 128 &&
        data.targetStatus is string &&
        data.targetStatus.size() >= 1 &&
        data.targetStatus.size() <= 32 &&
        data.adminSecret is string &&
        data.adminSecret.size() >= 16 &&
        data.adminSecret.size() <= 128 &&
        data.createdAt is timestamp;
    }

    function hasValidAdminProof(proofId, targetType, targetId, targetStatus) {
      return isValidId(proofId) &&
        proofId.size() >= 20 &&
        existsAfter(/databases/$(database)/documents/adminProofs/$(proofId)) &&
        getAfter(/databases/$(database)/documents/adminProofs/$(proofId)).data.targetType == targetType &&
        getAfter(/databases/$(database)/documents/adminProofs/$(proofId)).data.targetId == targetId &&
        getAfter(/databases/$(database)/documents/adminProofs/$(proofId)).data.targetStatus == targetStatus;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'shopId',
          'orderNumber',
          'piiEncrypted',
          'encryptedPii',
          'customerName',
          'customerPhone',
          'orderMode',
          'address',
          'gpsText',
          'paymentMethod',
          'notes',
          'items',
          'subtotal',
          'foodTax',
          'drinksTax',
          'deliveryFee',
          'total',
          'status',
          'lastActionId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId',
          'orderNumber',
          'piiEncrypted',
          'encryptedPii',
          'customerName',
          'customerPhone',
          'orderMode',
          'address',
          'gpsText',
          'paymentMethod',
          'notes',
          'items',
          'subtotal',
          'foodTax',
          'drinksTax',
          'deliveryFee',
          'total',
          'status',
          'lastActionId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.shopId == 'kairos_rostock' &&
        data.orderNumber is string &&
        data.orderNumber.size() >= 3 &&
        data.orderNumber.size() <= 32 &&
        data.piiEncrypted is bool &&
        data.encryptedPii is string &&
        data.encryptedPii.size() <= 16000 &&
        data.customerName is string &&
        data.customerName.size() >= 1 &&
        data.customerName.size() <= 80 &&
        data.customerPhone is string &&
        data.customerPhone.size() >= 1 &&
        data.customerPhone.size() <= 32 &&
        data.orderMode in ['delivery', 'pickup'] &&
        data.address is string &&
        data.address.size() <= 240 &&
        data.gpsText is string &&
        data.gpsText.size() <= 64 &&
        data.paymentMethod in ['cash', 'payment_link'] &&
        data.notes is string &&
        data.notes.size() <= 300 &&
        data.items is list &&
        data.items.size() >= 1 &&
        data.items.size() <= 50 &&
        data.items[0] is map &&
        data.items[0].keys().hasAll(['dishId', 'nameAr', 'nameDe', 'qty', 'unitPrice', 'taxRate']) &&
        data.items[0].keys().hasOnly(['dishId', 'itemNumber', 'nameAr', 'nameDe', 'variantLabel', 'qty', 'unitPrice', 'taxRate']) &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.foodTax is number && data.foodTax >= 0 &&
        data.drinksTax is number && data.drinksTax >= 0 &&
        data.deliveryFee is number && data.deliveryFee >= 0 &&
        data.total is number && data.total >= 0 &&
        isValidOrderStatus(data.status) &&
        data.lastActionId is string &&
        data.lastActionId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrderTracking(data) {
      return data.keys().hasAll([
          'orderNumber',
          'status',
          'statusMessageAr',
          'statusMessageDe',
          'total',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'orderNumber',
          'status',
          'statusMessageAr',
          'statusMessageDe',
          'total',
          'createdAt',
          'updatedAt'
        ]) &&
        data.orderNumber is string &&
        data.orderNumber.size() >= 3 &&
        data.orderNumber.size() <= 32 &&
        isValidOrderStatus(data.status) &&
        data.statusMessageAr is string &&
        data.statusMessageAr.size() <= 200 &&
        data.statusMessageDe is string &&
        data.statusMessageDe.size() <= 200 &&
        data.total is number && data.total >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidComplaint(data) {
      return data.keys().hasAll([
          'shopId',
          'complaintNumber',
          'piiEncrypted',
          'encryptedPii',
          'customerName',
          'customerPhone',
          'orderNumber',
          'category',
          'message',
          'status',
          'adminNote',
          'lastActionId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shopId',
          'complaintNumber',
          'piiEncrypted',
          'encryptedPii',
          'customerName',
          'customerPhone',
          'orderNumber',
          'category',
          'message',
          'status',
          'adminNote',
          'lastActionId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.shopId == 'kairos_rostock' &&
        data.complaintNumber is string &&
        data.complaintNumber.size() >= 3 &&
        data.complaintNumber.size() <= 32 &&
        data.piiEncrypted is bool &&
        data.encryptedPii is string &&
        data.encryptedPii.size() <= 16000 &&
        data.customerName is string &&
        data.customerName.size() >= 1 &&
        data.customerName.size() <= 80 &&
        data.customerPhone is string &&
        data.customerPhone.size() <= 32 &&
        data.orderNumber is string &&
        data.orderNumber.size() <= 32 &&
        data.category in ['delivery_delay', 'food_quality', 'missing_item', 'service', 'other'] &&
        data.message is string &&
        data.message.size() >= 1 &&
        data.message.size() <= 600 &&
        data.status in ['new', 'reviewed', 'resolved'] &&
        data.adminNote is string &&
        data.adminNote.size() <= 300 &&
        data.lastActionId is string &&
        data.lastActionId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /kitchenVault/{vaultId} {
      allow get: if vaultId == 'rostock';
      allow list: if false;
      allow create: if vaultId == 'rostock' &&
        isValidVault(incoming()) &&
        incoming().lastActionId == 'init' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if vaultId == 'rostock' &&
        isValidVault(incoming()) &&
        incoming().publicKeyJwk == existing().publicKeyJwk &&
        incoming().adminSecretHash == existing().adminSecretHash &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['encryptedVaultBlob', 'salt', 'iv', 'lastActionId', 'updatedAt']) &&
        hasValidAdminProof(incoming().lastActionId, 'vault', vaultId, 'pin_rotate');
      allow delete: if false;
    }

    match /adminProofs/{proofId} {
      allow get, list: if false;
      allow create: if isValidId(proofId) &&
        proofId.size() >= 20 &&
        isValidAdminProof(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/kitchenVault/rostock) &&
        hashing.sha256(incoming().adminSecret).toBase64() ==
          get(/databases/$(database)/documents/kitchenVault/rostock).data.adminSecretHash;
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) &&
        orderId.size() >= 20 &&
        existing().shopId == 'kairos_rostock';
      allow list: if resource.data.shopId == 'kairos_rostock' &&
        isValidOrderStatus(resource.data.status);
      allow create: if isValidId(orderId) &&
        orderId.size() >= 20 &&
        isValidOrder(incoming()) &&
        incoming().status == 'pending' &&
        incoming().lastActionId == 'created' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/orderTracking/$(orderId));
      allow update: if isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().shopId == existing().shopId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastActionId', 'updatedAt']) &&
        hasValidAdminProof(incoming().lastActionId, 'order', orderId, incoming().status);
      allow delete: if false;
    }

    match /orderTracking/{orderId} {
      allow get: if isValidId(orderId) && orderId.size() >= 20;
      allow list: if false;
      allow create: if isValidId(orderId) &&
        orderId.size() >= 20 &&
        isValidOrderTracking(incoming()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/orders/$(orderId));
      allow update: if isValidId(orderId) &&
        isValidOrderTracking(incoming()) &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'statusMessageAr',
          'statusMessageDe',
          'updatedAt'
        ]) &&
        getAfter(/databases/$(database)/documents/orders/$(orderId)).data.status == incoming().status;
      allow delete: if false;
    }

    match /complaints/{complaintId} {
      allow get: if isValidId(complaintId) &&
        complaintId.size() >= 20 &&
        existing().shopId == 'kairos_rostock';
      allow list: if resource.data.shopId == 'kairos_rostock' &&
        resource.data.status in ['new', 'reviewed', 'resolved'];
      allow create: if isValidId(complaintId) &&
        complaintId.size() >= 20 &&
        isValidComplaint(incoming()) &&
        incoming().status == 'new' &&
        incoming().adminNote == '' &&
        incoming().lastActionId == 'created' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(complaintId) &&
        isValidComplaint(incoming()) &&
        incoming().shopId == existing().shopId &&
        incoming().complaintNumber == existing().complaintNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'lastActionId', 'updatedAt']) &&
        hasValidAdminProof(incoming().lastActionId, 'complaint', complaintId, incoming().status);
      allow delete: if false;
    }
  }
}
