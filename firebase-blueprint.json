{
  "entities": {
    "KitchenVault": {
      "title": "KitchenVault",
      "description": "End-to-end encrypted restaurant tablet configuration storing the public RSA key, PBKDF2/AES-GCM wrapped private key, and SHA-256 admin write secret digest.",
      "type": "object",
      "properties": {
        "publicKeyJwk": {
          "type": "string",
          "minLength": 50,
          "maxLength": 2000,
          "description": "RSA-OAEP-256 JWK public key used by customer checkouts to encrypt PII."
        },
        "encryptedVaultBlob": {
          "type": "string",
          "minLength": 40,
          "maxLength": 12000,
          "description": "AES-256-GCM encrypted JSON containing RSA private key JWK and adminWriteSecret."
        },
        "salt": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128,
          "description": "Base64 PBKDF2 salt."
        },
        "iv": {
          "type": "string",
          "minLength": 12,
          "maxLength": 64,
          "description": "Base64 AES-GCM IV."
        },
        "adminSecretHash": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128,
          "description": "Base64 SHA-256 digest of the adminWriteSecret verified on write-only adminProofs."
        },
        "lastActionId": {
          "type": "string",
          "maxLength": 128,
          "description": "Reference to the latest write-only adminProof used to rotate the PIN."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "publicKeyJwk",
        "encryptedVaultBlob",
        "salt",
        "iv",
        "adminSecretHash",
        "lastActionId",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminProof": {
      "title": "AdminProof",
      "description": "Write-only proof document created atomically in the same batch as an order, complaint, or vault update.",
      "type": "object",
      "properties": {
        "targetType": {
          "type": "string",
          "enum": ["order", "complaint", "vault"],
          "description": "Type of target resource."
        },
        "targetId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "description": "ID of target document."
        },
        "targetStatus": {
          "type": "string",
          "maxLength": 32,
          "description": "Target status or action."
        },
        "adminSecret": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "description": "Admin write secret verified via SHA-256 in Firestore Rules."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": ["targetType", "targetId", "targetStatus", "adminSecret", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with itemized VAT invoice and E2EE encrypted PII delivered directly to the shop tablet.",
      "type": "object",
      "properties": {
        "shopId": {
          "type": "string",
          "enum": ["kairos_rostock"],
          "description": "Restaurant channel identifier."
        },
        "orderNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "description": "Human-friendly order reference (e.g., KG-4821)."
        },
        "piiEncrypted": {
          "type": "boolean",
          "description": "Whether customer PII is RSA-OAEP + AES-GCM encrypted."
        },
        "encryptedPii": {
          "type": "string",
          "maxLength": 16000,
          "description": "Encrypted JSON payload containing customerName, customerPhone, address, gpsText, notes."
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Masked placeholder when encrypted, or customer name."
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 32,
          "description": "Masked placeholder when encrypted, or customer phone."
        },
        "orderMode": {
          "type": "string",
          "enum": ["delivery", "pickup"],
          "description": "Delivery or pickup."
        },
        "address": {
          "type": "string",
          "maxLength": 240,
          "description": "Masked placeholder when encrypted, or delivery address."
        },
        "gpsText": {
          "type": "string",
          "maxLength": 64,
          "description": "Empty when encrypted, or GPS coordinates."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "payment_link"],
          "description": "Selected payment method."
        },
        "notes": {
          "type": "string",
          "maxLength": 300,
          "description": "Empty when encrypted, or order notes."
        },
        "items": {
          "type": "array",
          "description": "Bounded list of ordered line items (max 50)."
        },
        "subtotal": {
          "type": "number",
          "description": "Net item subtotal in EUR."
        },
        "foodTax": {
          "type": "number",
          "description": "7% food VAT in EUR."
        },
        "drinksTax": {
          "type": "number",
          "description": "19% drinks VAT in EUR."
        },
        "deliveryFee": {
          "type": "number",
          "description": "Delivery fee in EUR."
        },
        "total": {
          "type": "number",
          "description": "Grand total including VAT and delivery."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "preparing", "delivering", "completed", "cancelled"],
          "description": "Current order lifecycle status."
        },
        "lastActionId": {
          "type": "string",
          "maxLength": 128,
          "description": "Latest write-only adminProof ID used to authorize status transition."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "shopId",
        "orderNumber",
        "piiEncrypted",
        "encryptedPii",
        "customerName",
        "customerPhone",
        "orderMode",
        "address",
        "gpsText",
        "paymentMethod",
        "notes",
        "items",
        "subtotal",
        "foodTax",
        "drinksTax",
        "deliveryFee",
        "total",
        "status",
        "lastActionId",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderTracking": {
      "title": "OrderTracking",
      "description": "Non-PII live order status record read by the customer browser after placing an order.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "description": "Human-friendly order reference."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "preparing", "delivering", "completed", "cancelled"],
          "description": "Current live status."
        },
        "statusMessageAr": {
          "type": "string",
          "maxLength": 200,
          "description": "Localized Arabic status notification message."
        },
        "statusMessageDe": {
          "type": "string",
          "maxLength": 200,
          "description": "Localized German status notification message."
        },
        "total": {
          "type": "number",
          "description": "Order grand total in EUR."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "orderNumber",
        "status",
        "statusMessageAr",
        "statusMessageDe",
        "total",
        "createdAt",
        "updatedAt"
      ]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Customer complaint or management feedback with E2EE encrypted details visible only after PIN unlock.",
      "type": "object",
      "properties": {
        "shopId": {
          "type": "string",
          "enum": ["kairos_rostock"],
          "description": "Restaurant channel identifier."
        },
        "complaintNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "description": "Human-friendly complaint reference (e.g., CMP-4821)."
        },
        "piiEncrypted": {
          "type": "boolean",
          "description": "Whether complaint details are encrypted."
        },
        "encryptedPii": {
          "type": "string",
          "maxLength": 16000,
          "description": "Encrypted JSON payload containing customerName, customerPhone, message."
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Masked or plain customer name."
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 32,
          "description": "Masked or plain customer phone."
        },
        "orderNumber": {
          "type": "string",
          "maxLength": 32,
          "description": "Optional related order number."
        },
        "category": {
          "type": "string",
          "enum": ["delivery_delay", "food_quality", "missing_item", "service", "other"],
          "description": "Complaint category."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Masked placeholder when encrypted, or complaint text."
        },
        "status": {
          "type": "string",
          "enum": ["new", "reviewed", "resolved"],
          "description": "Complaint handling status."
        },
        "adminNote": {
          "type": "string",
          "maxLength": 300,
          "description": "Internal management note."
        },
        "lastActionId": {
          "type": "string",
          "maxLength": 128,
          "description": "Latest write-only adminProof ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "shopId",
        "complaintNumber",
        "piiEncrypted",
        "encryptedPii",
        "customerName",
        "customerPhone",
        "orderNumber",
        "category",
        "message",
        "status",
        "adminNote",
        "lastActionId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/kitchenVault/{vaultId}": {
      "schema": { "$ref": "#/entities/KitchenVault" },
      "description": "Public RSA key and PIN-encrypted private vault for the restaurant tablet."
    },
    "/adminProofs/{proofId}": {
      "schema": { "$ref": "#/entities/AdminProof" },
      "description": "Write-only authorization proofs checked by SHA-256 digest in Firestore Rules."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Live customer orders delivered directly to the restaurant tablet."
    },
    "/orderTracking/{orderId}": {
      "schema": { "$ref": "#/entities/OrderTracking" },
      "description": "Non-PII real-time status updates subscribed to by the ordering customer."
    },
    "/complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/Complaint" },
      "description": "Customer complaints submitted from the Management & Complaints modal."
    }
  }
}
